{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rootmode",
  "version": "0.1.9",
  "identifier": "ai.rootmode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rootmode",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#08090a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "rootmode",
    "shortDescription": "your keys, your peers",
    "longDescription": "rootmode is a local-first desktop client for discovering peers and submitting LLM inference and image generation jobs to them."
  }
}
