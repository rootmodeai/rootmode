{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal surface: the window itself, IPC to our own commands, and revealing a saved result in the file manager. No shell, no fs, no http from the frontend.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://127.0.0.1:17331/*" },
        { "url": "http://localhost:17331/*" },
        { "url": "https://basescan.org/*" },
        { "url": "https://sepolia.basescan.org/*" },
        { "url": "https://rootmode.ai/download" },
        { "url": "https://rootmode.ai/download/*" },
        { "url": "https://github.com/rootmodeai/rootmode/releases/*" }
      ]
    }
  ]
}
