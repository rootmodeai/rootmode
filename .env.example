# Copy to .env and edit. This file is the whole machine-specific config.
# The compose file itself is the same on every box.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# At least one backend is required. Uncomment what this box actually runs.

# Shown to clients. Empty = the machine's hostname.
# ROOTMODE_LABEL=

# OpenAI-compatible server (vLLM, SGLang, llama.cpp, …).
# Comma-separate if you run more than one.
ROOTMODE_VLLM=http://127.0.0.1:8000
# ROOTMODE_VLLM_API_KEY=
# ROOTMODE_VLLM_MODELS=

# What you charge. Leave unset to advertise as free — clients pick the cheapest.
# One number covers every model that server reports (per million tokens).
# ROOTMODE_VLLM_PRICE=0.15
# Per-model overrides, if you want: id=amount,id=amount
# ROOTMODE_VLLM_PRICES=meta-llama/Llama-3.1-8B-Instruct=0.40

# ComfyUI, if this box also (or only) serves images. Official default port is 8188.
# Pointing at the endpoint is enough: the worker advertises every checkpoint
# the server reports. Name a workflow only for a pipeline with a shape of its
# own — LoRAs, ControlNet, Flux-style graphs.
# ROOTMODE_COMFYUI=http://127.0.0.1:8188
# Per image. One number covers every checkpoint; overrides win for named ones.
# ROOTMODE_COMFYUI_PRICE=0.02
# ROOTMODE_COMFYUI_PRICES=sdxl=0.02,flux1-dev=0.05,krea2-turbo=0.08
# ROOTMODE_COMFYUI_CHECKPOINT=
# ROOTMODE_COMFYUI_WORKFLOW=/etc/rootmode/workflows/my_workflow.json
# ROOTMODE_COMFYUI_WORKFLOWS=krea2=/etc/rootmode/workflows/krea2.json
# ROOTMODE_COMFYUI_SLOTS=prompt=6.inputs.text,seed=3.inputs.seed

# ROOTMODE_CURRENCY=USD
# Getting paid. A price without a pot is only a sticker.
# ROOTMODE_PAYOUT is where the 90% USDC lands (can be a cold wallet).
# ROOTMODE_PAY_KEY is this node's Ethereum private key (secp256k1, 32-byte
# hex — same shape MetaMask exports). It signs settle and needs a little ETH
# for gas. It does not have to be the payout address.
# ROOTMODE_PAYOUT=0x…
# ROOTMODE_POT=0x…              # RootmodePot address
# ROOTMODE_CHAIN_ID=8453        # Base
# ROOTMODE_RPC=https://mainnet.base.org
# ROOTMODE_PAY_KEY=
# ROOTMODE_PAY_SENDER=0x…       # optional; derived from the key if omitted

# ROOTMODE_MAX_CONCURRENT=2
# ROOTMODE_COUNTRY=US
# ROOTMODE_BOOTSTRAP=
# ROOTMODE_P2P_EXTERNAL=/ip4/203.0.113.10/tcp/4101
